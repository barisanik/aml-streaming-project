    {
      "id": 4,
      "type": "stat",
      "title": "Detection latency p50",
      "description": "Median of alert_time - produced_at for alerts in the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
