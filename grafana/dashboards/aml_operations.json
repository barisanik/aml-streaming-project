            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY detection_latency_ms) AS p50 FROM raw.alerts WHERE $__timeFilter(alert_time)"
