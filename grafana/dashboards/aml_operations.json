    {
      "id": 10,
      "type": "table",
      "title": "Consumer partitions",
      "description": "Last heartbeat per partition. lag = log_end_offset - committed_offset. messages_processed counts since the consumer process started.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    partition,\n    committed_offset,\n    log_end_offset,\n    CASE WHEN committed_offset >= 0 AND log_end_offset IS NOT NULL\n         THEN GREATEST(log_end_offset - committed_offset, 0) END AS lag,\n    messages_processed,\n    EXTRACT(EPOCH FROM now() - heartbeat_at) AS heartbeat_age_s\nFROM ops.consumer_heartbeat\nWHERE consumer_group = '$consumer_group' AND topic = 'transactions'\nORDER BY partition"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "heartbeat_age_s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 30
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "lag"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 1000
                    },
                    {
                      "color": "red",
                      "value": 10000
                    }
