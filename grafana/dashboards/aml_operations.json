          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    $__timeGroupAlias(alert_time, '1m'),\n    percentile_cont(0.5) WITHIN GROUP (ORDER BY detection_latency_ms) AS p50,\n    percentile_cont(0.95) WITHIN GROUP (ORDER BY detection_latency_ms) AS p95\nFROM raw.alerts\nWHERE $__timeFilter(alert_time)\nGROUP BY 1\nORDER BY 1"
