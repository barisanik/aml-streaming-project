  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Transactions / min",
      "description": "Rows written to raw.transactions in the last minute (wall clock).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS transactions FROM raw.transactions WHERE inserted_at >= now() - INTERVAL '1 minute'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Since last transaction",
      "description": "Seconds since the last row reached raw.transactions. The no-data alarm fires at 120 s.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM now() - MAX(inserted_at)) AS seconds FROM raw.transactions"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
