    {
      "id": 12,
      "type": "table",
      "title": "Detection performance by scenario type",
      "description": "From analytics.mart_detection_performance, rebuilt by dbt_scheduler.py. Recall and precision against the answer key over all data in the database, not only the selected time range. Latency columns are for the first true positive alert per scenario. Grafana reads only this aggregated mart, never the answer key itself.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 6,
        "y": 20,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    scope,\n    rule_id                         AS rule,\n    scenarios_evaluated             AS evaluated,\n    scenarios_detected              AS detected,\n    100 * recall                    AS recall_pct,\n    100 * precision_strict          AS prec_strict_pct,\n    100 * precision_related         AS prec_related_pct,\n    100 * precision_detections      AS prec_detection_pct,\n    p50_first_detection_latency_ms  AS p50_latency_ms,\n    p95_first_detection_latency_ms  AS p95_latency_ms,\n    evaluated_at\nFROM analytics.mart_detection_performance\nORDER BY scope = 'overall' DESC, scope"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_pct$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*_latency_ms$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
