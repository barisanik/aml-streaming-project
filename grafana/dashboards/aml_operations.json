      "type": "timeseries",
      "title": "Transactions per minute",
      "description": "Rows written to raw.transactions per minute.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
