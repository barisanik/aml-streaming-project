    {
      "id": 6,
      "type": "stat",
      "title": "Consumer lag",
      "description": "Messages not yet read by the consumer group, summed over partitions (log_end_offset - committed_offset from the last heartbeat).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT SUM(GREATEST(log_end_offset - committed_offset, 0)) AS lag\nFROM ops.consumer_heartbeat\nWHERE consumer_group = '$consumer_group' AND topic = 'transactions'\n  AND committed_offset >= 0\n  AND log_end_offset IS NOT NULL"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 10000
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto"
      }
    },
    {
