    {
      "id": 3,
      "type": "stat",
      "title": "Alert rate",
      "description": "Alerts per transaction in the selected time range.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 100.0 * (SELECT COUNT(*) FROM raw.alerts WHERE $__timeFilter(alert_time))\n     / NULLIF((SELECT COUNT(*) FROM raw.transactions WHERE $__timeFilter(inserted_at)), 0) AS alert_rate_pct"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
