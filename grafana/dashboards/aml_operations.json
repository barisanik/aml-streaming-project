            "uid": "aml-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(inserted_at, '1m', 0), COUNT(*) AS transactions\nFROM raw.transactions\nWHERE $__timeFilter(inserted_at)\nGROUP BY 1\nORDER BY 1"
