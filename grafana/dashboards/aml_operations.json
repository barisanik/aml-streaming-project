    {
      "id": 9,
      "type": "timeseries",
      "title": "Detection latency per minute",
      "description": "p50 and p95 of detection_latency_ms (alert_time - produced_at) per minute.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "aml-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
